# Supabase PostgreSQL Connection URI
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Production MongoDB Primary Cluster URI (Legacy)
MONGODB_PRODUCTION_URI="mongodb+srv://user:password@cluster0.mongodb.net/bilal_hospital_prod?retryWrites=true&w=majority"

# Backup MongoDB Secondary Cluster URI (Isolate from normal application queries)
MONGODB_BACKUP_URI="mongodb+srv://user:password@cluster0.mongodb.net/bilal_hospital_backup?retryWrites=true&w=majority"

# Server Port & Environment Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Local Electronic Patient File Storage Root Directory
# Development: ./storage/patient-files  or  D:/HMS/patient-files
# Production: /var/lib/hms/patient-files
PATIENT_FILES_ROOT="./storage/patient-files"

