generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  legacyId      String?  @unique
  username      String   @unique
  email         String   @unique
  passwordHash  String
  fullName      String
  role          String   @default("ADMIN") // RoleType: ADMIN, CONSULTANT, RECEPTIONIST, LAB_STAFF, PHARMACY_STAFF, ULTRASOUND_STAFF
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consultantProfile Consultant?
  auditLogs         AuditLog[]
  cashTransactions  CashTransaction[]
  inventoryTransactions InventoryTransaction[]
  dispensedDispensings PharmacyDispensing[] @relation("DispensingUser")
  referralForms     ReferralForm[]
  dischargeForms    DischargeForm[]
  admissionForms    AdmissionForm[]
  operationNotes    OperationNote[]
  doctorNotes       DoctorNote[]
  createdPatientDocuments PatientDocument[] @relation("PatientDocumentCreator")
}

model Consultant {
  id              String   @id @default(uuid())
  legacyId        String?  @unique
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty       String
  department      String
  qualification   String
  roomNumber      String
  consultationFee Decimal  @default(0.0)
  isAvailable     Boolean  @default(true)

  visits              PatientVisit[]
  consultations       Consultation[]
  prescriptions       Prescription[]
  labOrders           LabOrder[]
  ultrasoundOrders    UltrasoundOrder[]
  labRevisions        LabRevisionRequest[]
  ultrasoundRevisions UltrasoundRevisionRequest[]
}

model Patient {
  id                String   @id @default(uuid())
  legacyId          String?  @unique
  mrNumber          String   @unique
  fullName          String
  fatherHusbandName String?
  gender            String
  dob               DateTime?
  age               Int
  phone             String
  address           String?
  cnic              String?  @unique
  emergencyContact  String?
  bloodGroup        String?
  notes             String?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  visits           PatientVisit[]
  consultations    Consultation[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  ultrasoundOrders UltrasoundOrder[]
  cashTransactions CashTransaction[]
  otRecords        OTRecord[]
  gyneRecords      GyneRecord[]
  pharmacyDispensings PharmacyDispensing[]
  referralForms    ReferralForm[]
  dischargeForms   DischargeForm[]
  admissionForms   AdmissionForm[]
  operationNotes   OperationNote[]
  doctorNotes      DoctorNote[]
  patientDocuments PatientDocument[]
}

model PatientVisit {
  id              String   @id @default(uuid())
  legacyId        String?  @unique
  visitNumber     String   @unique
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientName     String?
  mrNumber        String?
  consultantId    String
  consultant      Consultant @relation(fields: [consultantId], references: [id])
  consultantName  String?
  visitDate       DateTime @default(now())
  arrivalTime     DateTime @default(now())
  department      String
  visitType       String   @default("OPD")
  reasonForVisit  String?
  consultationFee Decimal  @default(0.0)
  amountReceived  Decimal  @default(0.0)
  paymentMethod   String   @default("CASH")
  receptionistId  String
  status          String   @default("REGISTERED") // REGISTERED, WAITING, WITH_CONSULTANT, LAB_REQUESTED, PHARMACY, COMPLETED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultations    Consultation[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  ultrasoundOrders UltrasoundOrder[]
  cashTransactions CashTransaction[]
  otRecords        OTRecord[]
  gyneRecords      GyneRecord[]
  referralForms    ReferralForm[]
  dischargeForms   DischargeForm[]
  admissionForms   AdmissionForm[]
  operationNotes   OperationNote[]
  doctorNotes      DoctorNote[]
  patientDocuments PatientDocument[]
}

model Consultation {
  id             String       @id @default(uuid())
  legacyId       String?      @unique
  visitId        String
  visit          PatientVisit @relation(fields: [visitId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  consultantId   String
  consultant     Consultant   @relation(fields: [consultantId], references: [id])
  chiefComplaint String
  symptoms       String?
  diagnosis      String
  bpSystolic     Int?
  bpDiastolic    Int?
  temperature    Float?
  pulse          Int?
  weight         Float?
  clinicalNotes  String?
  advice         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  prescriptions Prescription[]
}

model Prescription {
  id               String       @id @default(uuid())
  legacyId         String?      @unique
  patientId        String
  patient          Patient      @relation(fields: [patientId], references: [id])
  patientName      String?
  mrNumber         String?
  visitId          String
  visit            PatientVisit @relation(fields: [visitId], references: [id])
  consultantId     String
  consultant       Consultant   @relation(fields: [consultantId], references: [id])
  consultantName   String?
  consultationId   String?
  consultation     Consultation? @relation(fields: [consultationId], references: [id])
  diagnosis        String
  prescriptionDate DateTime     @default(now())
  notes            String?
  isDispensed      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  items      PrescriptionItem[]
  dispensing PharmacyDispensing[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  legacyId       String?
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  route          String?
  instructions   String?
}

model LabOrder {
  id                  String   @id @default(uuid())
  legacyId            String?  @unique
  orderNumber         String   @unique
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id])
  patientName         String?
  mrNumber            String?
  visitId             String
  visit               PatientVisit @relation(fields: [visitId], references: [id])
  consultantId        String
  consultant          Consultant @relation(fields: [consultantId], references: [id])
  consultantName      String?
  testCategory        String
  clinicalNotes       String?
  priority            String   @default("NORMAL")
  status              String   @default("ORDERED") // ORDERED, SAMPLE_COLLECTED, PROCESSING, REPORT_PREPARED, SUBMITTED_TO_CONSULTANT, REVISION_REQUESTED, ACCEPTED
  totalFee            Decimal  @default(0.0)
  requestDate         DateTime @default(now())
  currentVersion      Int?     @default(1)
  resultsV1           String?
  resultsV2           String?
  revisionReason      String?
  revisionComment     String?
  attachedPdfUrl      String?
  attachedPdfName     String?
  attachedImageBase64 String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  items     LabOrderItem[]
  reports   LabReport[]
  revisions LabRevisionRequest[]
}

model LabOrderItem {
  id         String   @id @default(uuid())
  legacyId   String?
  labOrderId String
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  testName   String
  testCode   String
  unitPrice  Decimal  @default(0.0)
}

model LabReport {
  id             String    @id @default(uuid())
  legacyId       String?   @unique
  labOrderId     String    @unique
  labOrder       LabOrder  @relation(fields: [labOrderId], references: [id])
  currentVersion Int       @default(1)
  isAccepted     Boolean   @default(false)
  acceptedAt     DateTime?
  acceptedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  versions  LabReportVersion[]
  revisions LabRevisionRequest[]
}

model LabReportVersion {
  id               String    @id @default(uuid())
  legacyId         String?
  labReportId      String
  labReport        LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)
  versionNumber    Int
  structuredResult String    // JSON string containing findings, reference ranges, abnormal flags
  summary          String?
  performedBy      String
  pdfUrl           String?
  createdAt        DateTime  @default(now())
}

model LabRevisionRequest {
  id            String     @id @default(uuid())
  legacyId      String?
  labOrderId    String
  labOrder      LabOrder   @relation(fields: [labOrderId], references: [id])
  labReportId   String
  labReport     LabReport  @relation(fields: [labReportId], references: [id])
  consultantId  String
  consultant    Consultant @relation(fields: [consultantId], references: [id])
  versionTarget Int
  reason        String
  comment       String
  status        String     @default("PENDING") // PENDING, RESOLVED
  createdAt     DateTime   @default(now())
  resolvedAt    DateTime?
}

model UltrasoundOrder {
  id                  String   @id @default(uuid())
  legacyId            String?  @unique
  orderNumber         String   @unique
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id])
  patientName         String?
  mrNumber            String?
  visitId             String
  visit               PatientVisit @relation(fields: [visitId], references: [id])
  consultantId        String
  consultant          Consultant @relation(fields: [consultantId], references: [id])
  consultantName      String?
  requestedExam       String
  clinicalIndication  String?
  priority            String   @default("NORMAL")
  status              String   @default("ORDERED") // ORDERED, PROCESSING, SUBMITTED_TO_CONSULTANT, REVISION_REQUESTED, ACCEPTED
  totalFee            Decimal  @default(0.0)
  requestDate         DateTime @default(now())
  attachedFileName    String?
  attachedPdfUrl      String?
  attachedImageUrl    String?
  attachedImageBase64 String?
  findingsV1          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reports   UltrasoundReport[]
  revisions UltrasoundRevisionRequest[]
}

model UltrasoundReport {
  id                String          @id @default(uuid())
  legacyId          String?         @unique
  ultrasoundOrderId String          @unique
  ultrasoundOrder   UltrasoundOrder @relation(fields: [ultrasoundOrderId], references: [id])
  currentVersion    Int             @default(1)
  isAccepted        Boolean         @default(false)
  acceptedAt        DateTime?
  acceptedBy        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  versions  UltrasoundReportVersion[]
  revisions UltrasoundRevisionRequest[]
}

model UltrasoundReportVersion {
  id                 String           @id @default(uuid())
  legacyId           String?
  ultrasoundReportId String
  ultrasoundReport   UltrasoundReport @relation(fields: [ultrasoundReportId], references: [id], onDelete: Cascade)
  versionNumber      Int
  findings           String
  impression         String
  sonographerNotes   String?
  imageUrl           String?
  pdfUrl             String?
  performedBy        String
  createdAt          DateTime         @default(now())
}

model UltrasoundRevisionRequest {
  id                 String           @id @default(uuid())
  legacyId           String?
  ultrasoundOrderId  String
  ultrasoundOrder    UltrasoundOrder  @relation(fields: [ultrasoundOrderId], references: [id])
  ultrasoundReportId String
  ultrasoundReport   UltrasoundReport @relation(fields: [ultrasoundReportId], references: [id])
  consultantId       String
  consultant         Consultant       @relation(fields: [consultantId], references: [id])
  versionTarget      Int
  reason             String
  comment            String
  status             String           @default("PENDING")
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?
}

model Medicine {
  id                String    @id @default(uuid())
  legacyId          String?   @unique
  genericName       String?
  brandName         String
  category          String    @default("General")
  dosageForm        String    @default("Tablet")
  strength          String?
  manufacturer      String?
  batchNumber       String?
  expiryDate        DateTime?
  unitPrice         Decimal   @default(0.0)
  purchasePrice     Decimal   @default(0.0)
  salePrice         Decimal   @default(0.0)
  currentStock      Int       @default(0)
  availableQuantity Int       @default(0)
  minimumStock      Int       @default(10)
  reorderLevel      Int       @default(10)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batches   MedicineBatch[]
  movements InventoryTransaction[]
  dispensingItems PharmacyDispensingItem[]
}

model MedicineBatch {
  id           String   @id @default(uuid())
  legacyId     String?
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber  String
  purchaseDate DateTime @default(now())
  expiryDate   DateTime
  quantity     Int
  costPrice    Decimal  @default(0.0)
  supplier     String?
  createdAt    DateTime @default(now())

  movements InventoryTransaction[]
}

model InventoryTransaction {
  id              String         @id @default(uuid())
  legacyId        String?
  medicineId      String
  medicine        Medicine       @relation(fields: [medicineId], references: [id])
  batchId         String?
  batch           MedicineBatch? @relation(fields: [batchId], references: [id])
  transactionType String         @default("PURCHASE") // PURCHASE, DISPENSE, RETURN, ADJUSTMENT, DAMAGED, EXPIRED
  quantity        Int
  quantityBefore  Int            @default(0)
  quantityAfter   Int            @default(0)
  unitCost        Decimal        @default(0.0)
  totalCost       Decimal        @default(0.0)
  supplierName    String?
  reason          String?
  batchNumber     String?
  referenceNo     String?
  performedById   String?
  performedBy     User?          @relation(fields: [performedById], references: [id])
  createdAt       DateTime       @default(now())
}

model PharmacyDispensing {
  id              String        @id @default(uuid())
  legacyId        String?       @unique
  prescriptionId  String?
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id])
  patientId       String?
  patient         Patient?      @relation(fields: [patientId], references: [id])
  patientName     String
  dispensedById   String?
  dispensedBy     User?         @relation("DispensingUser", fields: [dispensedById], references: [id])
  dispensedByName String        @default("Pharmacist")
  totalAmount     Decimal       @default(0.0)
  paymentStatus   String        @default("PAID")
  notes           String?
  dispensedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())

  items PharmacyDispensingItem[]
}

model PharmacyDispensingItem {
  id                   String             @id @default(uuid())
  legacyId             String?
  pharmacyDispensingId String
  pharmacyDispensing   PharmacyDispensing @relation(fields: [pharmacyDispensingId], references: [id], onDelete: Cascade)
  medicineId           String?
  medicine             Medicine?          @relation(fields: [medicineId], references: [id])
  medicineName         String
  quantity             Int
  unitPrice            Decimal            @default(0.0)
  totalPrice           Decimal            @default(0.0)
  batchNumber          String?
}

model OTRecord {
  id              String       @id @default(uuid())
  legacyId        String?      @unique
  otNumber        String       @unique
  patientId       String
  patient         Patient      @relation(fields: [patientId], references: [id])
  visitId         String
  visit           PatientVisit @relation(fields: [visitId], references: [id])
  surgeonName     String
  procedureName   String
  diagnosis       String
  otDate          DateTime
  scheduledTime   String
  actualStartTime String?
  actualEndTime   String?
  otRoom          String
  anesthesiaType  String
  anesthetistName String
  preOpNotes      String?
  procedureNotes  String?
  postOpNotes     String?
  status          String       @default("SCHEDULED") // SCHEDULED, ADMITTED, PRE_OP, IN_OT, POST_OP, RECOVERY, DISCHARGED
  totalFee        Decimal      @default(0.0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model GyneRecord {
  id                 String       @id @default(uuid())
  legacyId           String?      @unique
  gyneNumber         String       @unique
  patientId          String
  patient            Patient      @relation(fields: [patientId], references: [id])
  visitId            String
  visit              PatientVisit @relation(fields: [visitId], references: [id])
  consultantName     String
  admissionDate      DateTime     @default(now())
  reasonForAdmission String
  diagnosis          String
  bedNumber          String
  wardName           String
  treatmentPlan      String?
  dischargeDate      DateTime?
  dischargeNotes     String?
  status             String       @default("ADMITTED")
  totalFee           Decimal      @default(0.0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model CashTransaction {
  id                String        @id @default(uuid())
  legacyId          String?       @unique
  transactionNumber String        @unique
  transactionType   String        // INCOME, EXPENSE, REFUND, ADJUSTMENT, REVERSAL
  category          String
  department        String
  amount            Decimal       @default(0.0)
  paymentMethod     String        @default("CASH")
  description       String
  referenceNumber   String?
  patientId         String?
  patient           Patient?      @relation(fields: [patientId], references: [id])
  visitId           String?
  visit             PatientVisit? @relation(fields: [visitId], references: [id])
  createdById       String
  createdBy         User          @relation(fields: [createdById], references: [id])
  transactionDate   DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model DailyCashClosing {
  id              String   @id @default(uuid())
  legacyId        String?  @unique
  closingDate     DateTime @unique
  openingBalance  Decimal  @default(0.0)
  totalIncome     Decimal  @default(0.0)
  totalExpense    Decimal  @default(0.0)
  expectedClosing Decimal  @default(0.0)
  actualCash      Decimal  @default(0.0)
  difference      Decimal  @default(0.0)
  closedBy        String
  notes           String?
  isClosed        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  legacyId     String?  @unique
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  entityType   String   @default("UNKNOWN")
  entityId     String?
  userEmail    String?
  userName     String?
  userRole     String?
  ipAddress    String?
  userAgent    String?
  oldValues    String?  // JSON string
  newValues    String?  // JSON string
  description  String?
  status       String   @default("SUCCESS")
  errorMessage String?
  createdAt    DateTime @default(now())
}

model SystemHealthRecord {
  id               String   @id @default(uuid())
  legacyId         String?
  dbStatus         String   @default("HEALTHY")
  dbConnectionPool Int      @default(10)
  pitrStatus       String   @default("ACTIVE")
  lastBackupTime   DateTime @default(now())
  redisStatus      String   @default("CONNECTED")
  storageUsageMb   Float    @default(256.4)
  createdAt        DateTime @default(now())
}

model ReferralForm {
  id                    String   @id @default(uuid())
  formNumber            String   @unique
  patientId             String
  patient               Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId               String?
  visit                 PatientVisit? @relation(fields: [visitId], references: [id])
  formDate              DateTime @default(now())
  dateOfAdmission       DateTime?
  presentingComplaint   String?
  provisionalDiagnosis  String?
  briefHistoryExamination String?
  investigationsResults String?
  diagnosis             String?
  procedureDone         String?
  conditionAtRefer      String? // Satisfactory, Fair, Poor
  referredHospitalName  String?
  reasonForReferral     String?
  doctorName            String?
  signDate              DateTime?
  signTime              String?
  status                String   @default("FINALIZED")
  createdById           String?
  createdBy             User?    @relation(fields: [createdById], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  medicines ReferralFormMedicine[]
}

model ReferralFormMedicine {
  id             String       @id @default(uuid())
  referralFormId String
  referralForm   ReferralForm @relation(fields: [referralFormId], references: [id], onDelete: Cascade)
  srNo           Int
  medicine       String
  dose           String?
  route          String?
  frequency      String?
  timing         String?
  duration       String?
}

model DischargeForm {
  id                       String   @id @default(uuid())
  formNumber               String   @unique
  patientId                String
  patient                  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId                  String?
  visit                    PatientVisit? @relation(fields: [visitId], references: [id])
  formDate                 DateTime @default(now())
  dateOfAdmission          DateTime?
  presentingComplaint      String?
  briefHistoryExamination  String?
  diagnosticInvestigations String?
  diagnosis                String?
  procedureDone            String?
  outcome                  String?
  dischargeAdvisedByDoctor Boolean  @default(true)
  isLAMA                   Boolean  @default(false)
  dischargeDate            DateTime?
  dischargeCondition       String? // Satisfactory, Fair, Poor
  followUpDate             DateTime?
  followUpDepartment       String?
  dietaryInstructions      String?
  doctorName               String?
  signDate                 DateTime?
  signTime                 String?
  status                   String   @default("FINALIZED")
  createdById              String?
  createdBy                User?    @relation(fields: [createdById], references: [id])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  medicines DischargeFormMedicine[]
}

model DischargeFormMedicine {
  id              String        @id @default(uuid())
  dischargeFormId String
  dischargeForm   DischargeForm @relation(fields: [dischargeFormId], references: [id], onDelete: Cascade)
  srNo            Int
  medicine        String
  dose            String?
  route           String?
  frequency       String?
  timing          String?
  duration        String?
}

model AdmissionForm {
  id                   String   @id @default(uuid())
  formNumber           String   @unique
  patientId            String
  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId              String?
  visit                PatientVisit? @relation(fields: [visitId], references: [id])
  phcRegNumber         String?
  dateOfAdmission      DateTime @default(now())
  timeOfAdmission      String?
  maritalStatus        String?
  cnic                 String?
  provisionalDiagnosis String?
  finalDiagnosis       String?
  admittedThrough      String? // OPD, Emergency
  opdErMrNo            String?
  dateOfDischargeRefer DateTime?
  timeOfDischargeRefer String?
  consentName          String?
  consentRelation      String?
  consentSigned        Boolean  @default(true)
  status               String   @default("FINALIZED")
  createdById          String?
  createdBy            User?    @relation(fields: [createdById], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model OperationNote {
  id                    String   @id @default(uuid())
  formNumber            String   @unique
  patientId             String
  patient               Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId               String?
  visit                 PatientVisit? @relation(fields: [visitId], references: [id])
  operationDate         DateTime @default(now())
  operationTime         String?
  surgeonName           String
  assistantTeamName     String?
  anesthetistName       String?
  anesthesiaType        String?
  incision              String?
  procedureDetails      String?
  findings              String?
  drain                 String?
  specimenRemoved       String?
  histopathology        String?
  bloodLoss             String?
  transfusion           String?
  uneventfulDevelopment String?
  conditionAtEnd        String?
  postOpOrders          String?
  signDate              DateTime?
  signTime              String?
  status                String   @default("FINALIZED")
  createdById           String?
  createdBy             User?    @relation(fields: [createdById], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DoctorNote {
  id          String   @id @default(uuid())
  formNumber  String   @unique
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId     String?
  visit       PatientVisit? @relation(fields: [visitId], references: [id])
  noteDate    DateTime @default(now())
  noteTime    String?
  notes       String
  doctorName  String
  signDate    DateTime?
  signTime    String?
  status      String   @default("FINALIZED")
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// LOCAL ELECTRONIC PATIENT FILE / DOCUMENT ARCHIVE
// ─────────────────────────────────────────────────────────────────

model PatientDocument {
  id           String   @id @default(uuid())

  // Patient relationship (required)
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Visit/Admission relationship (optional – not every document is visit-scoped)
  visitId      String?
  visit        PatientVisit? @relation(fields: [visitId], references: [id])

  // The AdmissionForm formNumber that controls the admissions/<ADM-ID>/ subfolder
  // Must match the AdmissionForm.formNumber used at admission time
  admissionFormNumber String?

  // Document classification
  documentType String   // ADMISSION | DOCTOR_NOTE | PRESCRIPTION | LABORATORY | ULTRASOUND | OPERATION | REFERRAL | DISCHARGE | OTHER

  // Human-readable label shown in Patient File viewer (e.g. "Blood CBC Report – 2026-09-30")
  documentName String

  // Relative path from PATIENT_FILES_ROOT – used to reconstruct the full path on download
  // e.g. "35202-1234567-1/admissions/ADM-001/laboratory/lab-LAB-001-2026-09-30.json"
  relativePath String

  // File metadata
  fileName     String
  mimeType     String   @default("application/pdf")
  fileSize     Int      @default(0)  // bytes

  // SHA-256 checksum for integrity verification
  checksum     String?

  // Archive state
  // PENDING  – document queued but not yet written
  // ARCHIVED – file written and database record created
  // VERIFIED – checksum verified post-write
  // ERROR    – write or verification failed
  status       String   @default("ARCHIVED")

  // Error detail (populated only when status = ERROR)
  errorMessage String?

  // Audit
  createdById  String?
  createdBy    User?    @relation("PatientDocumentCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([patientId])
  @@index([visitId])
  @@index([admissionFormNumber])
  @@index([documentType])
  @@index([status])
}
